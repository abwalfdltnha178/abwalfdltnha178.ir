---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const formatFaDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<Layout
  title={`وبلاگ | ${siteConfig.name}`}
  description={`یادداشت‌ها و مقالات منتشرشده توسط ${siteConfig.name} در وب‌سایت ${siteConfig.domain}.`}
  path="/blog/"
  ogType="website"
  schemaType="WebSite"
>
  <section class="section-block first-section">
    <div class="section-header">
      <h1 class="section-title">وبلاگ</h1>
      <p class="section-subtitle">
        یادداشت‌ها، تجربه‌ها و گزارش‌های فنی منتشرشده به زبان فارسی.
      </p>
    </div>

    {
      posts.length > 0 ? (
        <div class="content-grid">
          {
            posts.map((post) => (
              <article
                class="liquid-glass content-card"
                data-thickness="40"
                data-blur="3"
                data-tint="255,255,255"
                data-tint-opacity="0.72"
              >
                <div class="card-meta">
                  <span class="card-badge">{post.data.category}</span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatFaDate(post.data.pubDate)}
                  </time>
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <a href={`/blog/${post.id}/`} class="card-link">مطالعه نوشته ←</a>
              </article>
            ))
          }
        </div>
      ) : (
        <div
          class="liquid-glass content-card"
          data-thickness="40"
          data-blur="3"
          data-tint="255,255,255"
          data-tint-opacity="0.72"
        >
          <h2>هنوز نوشته‌ای منتشر نشده است</h2>
          <p>مطالب وبلاگ به‌زودی در این بخش قرار می‌گیرند.</p>
        </div>
      )
    }
  </section>
</Layout>

<style>
  .first-section {
    margin-top: 8px;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 20px;
  }

  .content-card {
    border-radius: var(--radius-md);
    padding: 24px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: 10px;
  }

  .card-badge {
    background: rgba(35, 27, 77, 0.08);
    color: var(--accent-primary);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-weight: 700;
  }

  .content-card h2 {
    font-size: var(--text-lg);
    margin: 0 0 8px;
  }

  .content-card p {
    margin: 0 0 16px;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .card-link {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent-primary);
  }
</style>
