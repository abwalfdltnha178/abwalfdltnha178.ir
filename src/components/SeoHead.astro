---
import { siteConfig } from '../data/site';
import { socialLinks } from '../data/socials';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  schemaType?: 'WebSite' | 'Person' | 'Article' | 'CreativeWork';
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  path = '/',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  schemaType = 'WebSite',
} = Astro.props;

const normalizedPath = path.startsWith('/') ? path : `/${path}`;
const baseUrl = siteConfig.siteUrl.replace(/\/+$/, '');
const canonicalUrl = normalizedPath === '/' ? `${baseUrl}/` : `${baseUrl}${normalizedPath}`;

const sameAsUrls = socialLinks.map((item) => item.url);

const personSchema = {
  '@type': 'Person',
  name: siteConfig.name,
  alternateName: siteConfig.handle,
  url: `${baseUrl}/`,
  jobTitle: siteConfig.role,
  sameAs: sameAsUrls,
};

const websiteSchema = {
  '@type': 'WebSite',
  name: siteConfig.defaultTitle,
  alternateName: siteConfig.handle,
  url: `${baseUrl}/`,
  inLanguage: 'fa-IR',
  author: {
    '@type': 'Person',
    name: siteConfig.name,
  },
};

const contentSchema =
  schemaType === 'Article'
    ? {
        '@type': 'Article',
        headline: title,
        description,
        mainEntityOfPage: canonicalUrl,
        inLanguage: 'fa-IR',
        author: personSchema,
        ...(publishedTime ? { datePublished: publishedTime } : {}),
        ...(modifiedTime ? { dateModified: modifiedTime } : publishedTime ? { dateModified: publishedTime } : {}),
      }
    : schemaType === 'CreativeWork'
      ? {
          '@type': 'CreativeWork',
          name: title,
          description,
          url: canonicalUrl,
          inLanguage: 'fa-IR',
          creator: personSchema,
        }
      : null;

const graphNodes = contentSchema
  ? [websiteSchema, personSchema, contentSchema]
  : [websiteSchema, personSchema];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.name} />
<meta name="robots" content="index, follow" />

<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
