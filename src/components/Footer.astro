---
import { siteConfig } from '../data/site';
import { footerQuickLinks } from '../data/navigation';
import { socialLinks } from '../data/socials';
---

<footer class="site-footer glass-nav-bar">
  <div class="footer-grid">
    <div>
      <strong class="footer-brand-name">{siteConfig.name}</strong>
      <p class="footer-role">{siteConfig.role}</p>
      <p class="footer-desc">
        پورتفولیوی شخصی و آزمایشگاه زنده فناوری روی دامنه {siteConfig.domain} با میزبانی {siteConfig.hostingProvider}.
      </p>
    </div>

    <div>
      <h2 class="footer-heading">دسترسی سریع</h2>
      <ul class="footer-links">
        {
          footerQuickLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="footer-heading">شبکه‌ها و کانال‌ها</h2>
      <div class="footer-socials">
        {
          socialLinks.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social-chip"
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {siteConfig.name} ({siteConfig.domain})</span>
    <a href="#top" class="footer-top-link">بازگشت به بالا ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    border-radius: var(--radius-lg);
    padding: 28px 24px 20px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.5fr;
    gap: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-hairline);
  }

  .footer-brand-name {
    display: block;
    font-size: var(--text-lg);
    font-weight: 800;
    margin-bottom: 4px;
  }

  .footer-role {
    margin: 0 0 10px;
    font-size: var(--text-sm);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .footer-desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .footer-heading {
    font-size: var(--text-base);
    margin: 0 0 12px;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-primary);
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-social-chip {
    display: inline-block;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--border-hairline);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .footer-social-chip:hover {
    background: var(--accent-primary);
    color: #fff;
  }

  .footer-bottom {
    padding-top: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .footer-top-link {
    font-weight: 700;
    color: var(--accent-primary);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
