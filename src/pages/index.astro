---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="resume-container">
		<header class="resume-header">
			<h1>[Your Name]</h1>
			<p class="title">[Your Professional Title]</p>
			<div class="contact-info">
				<a href="mailto:your.email@example.com">your.email@example.com</a>
				<span>•</span>
				<a href="https://linkedin.com/in/yourprofile">LinkedIn</a>
				<span>•</span>
				<a href="https://github.com/yourusername">GitHub</a>
			</div>
		</header>

		<section class="resume-section">
			<h2>About Me</h2>
			<p>
				Brief introduction about yourself, your goals, and what you excel at.
				Keep it concise and professional.
			</p>
		</section>

		<section class="resume-section">
			<h2>Experience</h2>
			<div class="job">
				<h3>Job Title</h3>
				<div class="job-meta">
					<span class="company">Company Name</span>
					<span class="date">Month Year - Present</span>
				</div>
				<ul>
					<li>Key achievement or responsibility.</li>
					<li>Another important contribution to the team or project.</li>
				</ul>
			</div>
		</section>

		<section class="resume-section">
			<h2>Skills</h2>
			<ul class="skills-list">
				<li>Skill 1</li>
				<li>Skill 2</li>
				<li>Skill 3</li>
				<li>Skill 4</li>
			</ul>
		</section>
	</main>
</Layout>

<style>
	:root {
		--primary-color: #2c3e50;
		--secondary-color: #34495e;
		--accent-color: #3498db;
		--text-color: #333;
		--light-bg: #f9f9f9;
	}

	.resume-container {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
		color: var(--text-color);
		line-height: 1.6;
	}

	.resume-header {
		text-align: center;
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 2px solid var(--light-bg);
	}

	h1 {
		font-size: 2.5rem;
		color: var(--primary-color);
		margin: 0 0 0.5rem 0;
	}

	.title {
		font-size: 1.2rem;
		color: var(--secondary-color);
		margin: 0 0 1rem 0;
		font-weight: 500;
	}

	.contact-info {
		display: flex;
		justify-content: center;
		gap: 1rem;
		font-size: 0.9rem;
	}

	.contact-info a {
		color: var(--accent-color);
		text-decoration: none;
	}

	.contact-info a:hover,
	.contact-info a:focus-visible {
		text-decoration: underline;
		outline: 2px solid var(--accent-color);
		outline-offset: 2px;
	}

	.resume-section {
		margin-bottom: 2.5rem;
	}

	h2 {
		font-size: 1.5rem;
		color: var(--primary-color);
		border-bottom: 1px solid var(--light-bg);
		padding-bottom: 0.5rem;
		margin-bottom: 1rem;
	}

	h3 {
		font-size: 1.2rem;
		margin: 0 0 0.25rem 0;
	}

	.job {
		margin-bottom: 1.5rem;
	}

	.job-meta {
		display: flex;
		justify-content: space-between;
		font-size: 0.9rem;
		color: var(--secondary-color);
		margin-bottom: 0.5rem;
	}

	.job ul {
		margin: 0;
		padding-left: 1.5rem;
	}

	.skills-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.skills-list li {
		background: var(--light-bg);
		padding: 0.25rem 0.75rem;
		border-radius: 4px;
		font-size: 0.9rem;
	}
</style>
