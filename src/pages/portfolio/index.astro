---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const statusLabels: Record<string, string> = {
  'in-progress': 'در حال توسعه',
  completed: 'تکمیل‌شده',
  'live-lab': 'آزمایشگاه زنده',
};
---

<Layout
  title={`نمونه‌کارها | ${siteConfig.name}`}
  description={`پروژه‌ها و نمونه‌کارهای ${siteConfig.name}؛ وضعیت فعلی توسعه سایت ${siteConfig.domain} و آثار منتشرشده.`}
  path="/portfolio/"
  ogType="website"
  schemaType="WebSite"
>
  <section class="section-block first-section">
    <div class="section-header">
      <h1 class="section-title">نمونه‌کارها و پروژه‌ها</h1>
      <p class="section-subtitle">
        این بخش در حال تکمیل است؛ خودِ همین وب‌سایت روی دامنه abwalfdltnha178.ir در حال توسعه است و سایر پروژه‌ها به‌تدریج افزوده می‌شوند.
      </p>
    </div>

    {
      projects.length > 0 ? (
        <div class="projects-grid">
          {
            projects.map((project) => (
              <article
                class="liquid-glass project-card"
                data-thickness="40"
                data-blur="3"
                data-tint="255,255,255"
                data-tint-opacity="0.72"
              >
                <span class="status-badge">{statusLabels[project.data.status] ?? project.data.status}</span>
                <h2>{project.data.title}</h2>
                <p>{project.data.description}</p>
                {
                  project.data.stack.length > 0 && (
                    <ul class="stack-list">
                      {project.data.stack.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )
                }
                <a href={`/portfolio/${project.id}/`} class="card-link">مشاهده جزئیات ←</a>
              </article>
            ))
          }
        </div>
      ) : (
        <div
          class="liquid-glass project-card"
          data-thickness="40"
          data-blur="3"
          data-tint="255,255,255"
          data-tint-opacity="0.72"
        >
          <h2>مجموعه پروژه‌ها در حال آماده‌سازی است</h2>
          <p>
            در حال حاضر وب‌سایت شخصی روی دامنه abwalfdltnha178.ir در حال ساخت است و نمونه‌کارهای بیشتر به‌زودی اضافه می‌شوند.
          </p>
        </div>
      )
    }
  </section>
</Layout>

<style>
  .first-section {
    margin-top: 8px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 20px;
  }

  .project-card {
    border-radius: var(--radius-md);
    padding: 24px;
  }

  .status-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    background: rgba(74, 0, 224, 0.08);
    color: var(--accent-secondary);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: 10px;
  }

  .project-card h2 {
    font-size: var(--text-lg);
    margin: 0 0 8px;
  }

  .project-card p {
    margin: 0 0 14px;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .stack-list li {
    font-size: var(--text-xs);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(35, 27, 77, 0.08);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .card-link {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent-primary);
  }
</style>
